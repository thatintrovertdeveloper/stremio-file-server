#!/usr/bin/with-contenv bash
# oneshot: prepare persistent config layout before any service starts
set -euo pipefail

echo "[init-stremio-file-server] preparing /config"


# Persistent app state lives under /config (LSIO convention).
mkdir -p /config/subtitles-cache
chown "${PUID:-911}:${PGID:-911}" /config 2>/dev/null || true

# Media is read-only by design; sanity-check it exists so the scanner
# fails fast with a clear message instead of an empty catalog.
if [ ! -d "/media" ]; then
  echo "[init-stremio-file-server] WARNING: /media not mounted — set MEDIA_DIR volume"
fi

echo "[init-stremio-file-server] done"
