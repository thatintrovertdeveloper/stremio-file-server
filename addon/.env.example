# File server URL
FILE_SERVER_URL=http://localhost:3003

# API key (must match file server)
FILE_SERVER_API_KEY=

# Optional addon auth. When set, catalog/meta/stream require the key via
# X-API-Key, Bearer, or ?key= (Stremio clients: append ?key= to the install
# URL's endpoints). Manifest stays public so Stremio can install.
# Unset = LAN-open (previous behaviour).
ADDON_API_KEY=

# Upstream fetch timeouts (ms)
FILE_SERVER_TIMEOUT_MS=8000
TMDB_TIMEOUT_MS=8000
CINEMETA_TIMEOUT_MS=8000

# Addon port (default: 7001)
PORT=7001
